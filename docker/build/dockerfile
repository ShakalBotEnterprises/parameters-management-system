FROM debian

ENV JAVA_HOME /usr/lib/jvm/jdk-21.0.7-oracle-x64

EXPOSE 8080
EXPOSE 8443

RUN apt-get update
RUN apt-get install -y curl

RUN curl -o /jdk.deb https://download.oracle.com/java/21/latest/jdk-21_linux-x64_bin.deb
RUN apt-get install -y ./jdk.deb

ADD ./server-00.jar /server-00.jar
ENTRYPOINT java \
		-jar /server-00.jar \
		-XX:+UseContainerSupport \
		-XX:MaxRAMPercentage=70.0 \
		--spring.config.location=file:/volumes/pms-server/spring/application-PROD.yaml \
		--spring.profiles.active=PROD